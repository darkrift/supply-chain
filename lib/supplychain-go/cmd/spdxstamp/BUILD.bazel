load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "spdxstamp_lib",
    srcs = ["main.go"],
    importpath = "github.com/bazel-contrib/supply-chain/lib/supplychain-go/cmd/spdxstamp",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/sbom",
        "//internal/spdxnamespace",
        "@com_github_spdx_tools_golang//json",
        "@com_github_spdx_tools_golang//spdx",
        "@com_github_spdx_tools_golang//tagvalue",
        "@com_github_spdx_tools_golang//yaml",
