load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "spdxstamp_lib",
    srcs = ["main.go"],
    importpath = "github.com/bazel-contrib/supply-chain/lib/supplychain-go/cmd/spdxstamp",
    visibility = ["//visibility:private"],
    deps = [
        "//internal/sbom",
        "//internal/spdxnamespace",
    ],
)

go_binary(
    name = "spdxstamp",
    embed = [":spdxstamp_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "spdxstamp_test",
    srcs = ["main_test.go"],
    embed = [":spdxstamp_lib"],
    deps = ["//internal/sbom"],
)
