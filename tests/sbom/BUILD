load("@jq.bzl//jq:jq.bzl", "jq_test")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":manifest.bzl", "concluded_licenses_manifest")
load("@supply_chain_tools//sbom:cyclonedx.bzl", "cyclonedx")
load("@supply_chain_tools//sbom:sbom.bzl", "sbom")
load("@supply_chain_tools//sbom:spdx.bzl", "spdx")

SPDX_LICENSES = "[.packages[] | {purl: .externalRefs[0].referenceLocator, declared: .licenseDeclared, concluded: .licenseConcluded}] | sort_by(.purl)"

CYCLONEDX_LICENSES = "[.metadata.component, .components[]] | map({purl, licenses, evidence: .evidence.licenses}) | sort_by(.purl)"

# Fixture graph for the end-to-end tests of `concluded_licenses`:
#
#   root                MIT
#   |- dual             MIT OR Apache-2.0      concluded to MIT
#   |  `- transitive    GPL-2.0-only OR MIT    concluded to Apache-2.0 WITH LLVM-exception
#   |- untouched        BSD-3-Clause           not overridden
#   |- libfoo_amd64     LGPL-2.1-only OR MIT   pkg:deb/debian/libfoo@1.0?arch=amd64
#   `- libfoo_arm64     LGPL-2.1-only OR MIT   pkg:deb/debian/libfoo@1.0?arch=arm64
#
# The two libfoo packages only differ by their qualifiers, so one conclusion
# for pkg:deb/debian/libfoo@1.0 applies to both.

[
    [
        package_metadata(
            name = name + "_metadata",
            attributes = [":" + name + "_license"],
            purl = purl,
            tags = ["manual"],
        ),
        license(
            name = name + "_license",
            expression = expression,
            tags = ["manual"],
        ),
        filegroup(
            name = name,
            applicable_licenses = [":" + name + "_metadata"],
            srcs = srcs,
            tags = ["manual"],
        ),
    ]
    for name, purl, expression, srcs in [
        ("root", "pkg:generic/root@1.0.0", "MIT", [":dual", ":untouched", ":libfoo_amd64", ":libfoo_arm64"]),
        ("dual", "pkg:generic/dual@1.0.0", "MIT OR Apache-2.0", [":transitive"]),
        ("transitive", "pkg:generic/transitive@1.0.0", "GPL-2.0-only OR MIT", []),
        ("untouched", "pkg:generic/untouched@1.0.0", "BSD-3-Clause", []),
        ("libfoo_amd64", "pkg:deb/debian/libfoo@1.0?arch=amd64", "LGPL-2.1-only OR MIT", []),
        ("libfoo_arm64", "pkg:deb/debian/libfoo@1.0?arch=arm64", "LGPL-2.1-only OR MIT", []),
    ]
]

license(
    name = "dual_conclusion",
    kind = "@package_metadata//licenses/spdx:MIT",
    tags = ["manual"],
)

license(
    name = "transitive_conclusion",
    expression = "Apache-2.0 WITH LLVM-exception",
    tags = ["manual"],
)

sbom(
    name = "concluded_sbom",
    concluded_licenses = {
        "pkg:generic/dual@1.0.0": ":dual_conclusion",
        "pkg:generic/transitive@1.0.0": ":transitive_conclusion",
        # Shared lists may have entries for packages that are not in this SBOM.
        "pkg:generic/not_in_this_sbom@1.0.0": ":dual_conclusion",
        # Applies to the packages of every arch.
        "pkg:deb/debian/libfoo@1.0": ":dual_conclusion",
    },
    tags = ["manual"],
    target = ":root",
)

spdx(
    name = "concluded_spdx",
    sbom = ":concluded_sbom",
    tags = ["manual"],
)

cyclonedx(
    name = "concluded_cyclonedx",
    sbom = ":concluded_sbom",
    tags = ["manual"],
)

# Without `concluded_licenses`, the concluded license is the declared one.
sbom(
    name = "declared_sbom",
    tags = ["manual"],
    target = ":root",
)

spdx(
    name = "declared_spdx",
    sbom = ":declared_sbom",
    tags = ["manual"],
)

cyclonedx(
    name = "declared_cyclonedx",
    sbom = ":declared_sbom",
    tags = ["manual"],
)

# The reports generated by the rules, from `concluded_licenses` to the files,
# must have the declared and concluded licenses of //sbom/expected.
[
    jq_test(
        name = report + "_test",
        file1 = ":" + report,
        file2 = "expected/" + report + ".json",
        filter1 = filter,
    )
    for report, filter in {
        "concluded_spdx": SPDX_LICENSES,
        "declared_spdx": SPDX_LICENSES,
        "concluded_cyclonedx": CYCLONEDX_LICENSES,
        "declared_cyclonedx": CYCLONEDX_LICENSES,
    }.items()
]

# The `require_*` attributes must reach `cmd/sbom` (see concluded_licenses_cmd_test
# for what it does with them). Building these also checks that satisfied
# requirements do not fail the build.
sbom(
    name = "strict_sbom",
    concluded_licenses = {
        "pkg:generic/dual@1.0.0": ":dual_conclusion",
    },
    require_matched_concluded_licenses = True,
    require_resolved_choices = True,
    tags = ["manual"],
    target = ":root",
)

concluded_licenses_manifest(
    name = "strict_manifest",
    sbom = ":strict_sbom",
    tags = ["manual"],
)

concluded_licenses_manifest(
    name = "lenient_manifest",
    sbom = ":concluded_sbom",
    tags = ["manual"],
)

jq_test(
    name = "strict_manifest_test",
    file1 = ":strict_manifest",
    file2 = "expected/strict_manifest.json",
    filter1 = "{require_resolved_choices, require_matched_concluded_licenses}",
)

jq_test(
    name = "lenient_manifest_test",
    file1 = ":lenient_manifest",
    file2 = "expected/lenient_manifest.json",
    filter1 = "{require_resolved_choices, require_matched_concluded_licenses}",
)

# Runs the `cmd/sbom` binary used by the `sbom` rule, to check the concluded
# licenses it puts in the classifications and the errors it fails with.
sh_test(
    name = "concluded_licenses_cmd_test",
    srcs = ["concluded_licenses_cmd_test.sh"],
    args = ["$(rootpath @supply-chain-go//cmd/sbom)"],
    data = ["@supply-chain-go//cmd/sbom"],
)
